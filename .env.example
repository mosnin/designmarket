# ---------------------------------------------------------------------------
# Convex — database, auth, scheduled jobs, MCP + webhook HTTP routes
# Created by `npx convex dev` on first run.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Public site origin, used for canonical URLs, OG images and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (set with `npx convex env set`, not here — listed for reference)
# ---------------------------------------------------------------------------
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# SITE_URL=

# ---------------------------------------------------------------------------
# Billing — Pro plan. Entirely optional; the app runs without it.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO_MONTHLY=
